<UserControl x:Class="PowerModulesManager.MainLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PowerModulesManager"
             xmlns:features="clr-namespace:Telemetria.UI.Features;assembly=Telemetria.UI"
             xmlns:converters="clr-namespace:Telemetria.UI.Converters;assembly=Telemetria.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Resources>
                <Style x:Key="ControlBaseStyle" TargetType="{x:Type Control}">
                    <Setter Property="Margin" Value="5"/>
                </Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ControlBaseStyle}"/>
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource ControlBaseStyle}">
                    <Setter Property="Foreground" Value="AliceBlue"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
                <Style TargetType="{x:Type Label}" BasedOn="{StaticResource ControlBaseStyle}">
                    <Setter Property="Foreground" Value="AliceBlue"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="Width" Value="Auto"/>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="V: "/>
                <TextBox Text="{Binding Voltage}" MinWidth="100"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="A: "/>
                <TextBox Text="{Binding Current}" MinWidth="100"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Type module: "/>
                <ComboBox ItemsSource="{Binding TypesModuleList}" SelectedItem="{Binding TypeModule}" MinWidth="100"/>
                <Label Content="Can address module: "/>
                <TextBox Text="{Binding CanAddressStr}" MinWidth="100"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Frequency get data: " VerticalAlignment="Center"/>
                <TextBox Text="{Binding FreqGetData}" VerticalContentAlignment="Center"  MinWidth="100"/>
            </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content=" Start " IsEnabled="{Binding StartButtonEnable}" Command="{Binding StartCmd}" Margin="45, 5, 5, 5" MinWidth="100" MinHeight="40"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content=" Stop " IsEnabled="{Binding StopButtonEnable}" Command="{Binding StopCmd}" Margin="45, 5, 5, 5" MinWidth="100" MinHeight="40"/>
            </StackPanel>

            <DataGrid x:Name="TestEvDg" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"  features:DataGridBehavior.Autoscroll="True"
                 ItemsSource="{Binding Statuses}"
                 AutoGenerateColumns="False" Margin="5" IsReadOnly="false" CanUserAddRows="False"
                 CanUserDeleteRows="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ColumnWidth="*" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding PmData.Voltage}" Width="Auto" Header="Voltage" IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding PmData.Current}" Width="Auto" Header="Current" IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding Dt}" Width="Auto" Header="DateTime" IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding TestId}" Width="Auto" Header="SessionId" IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding PmData.State.Code}" Width="Auto" Header="Error code" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding PmData.State.Errors}" Width="*" Header="Errors" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
 
</UserControl>
